#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$SCRIPT_DIR/.." && pwd)

source "$ROOT_DIR/scripts/lib/llamacpp-env.sh"

MODEL_NAME=${1:-${MODEL_NAME:-$LLAMACPP_DEFAULT_MODEL}}
llamacpp_load_model_config "$MODEL_NAME"

[[ -n ${HF_REPO:-} ]] || llamacpp_die "HF_REPO is not set in $MODEL_CONFIG"
[[ -n ${HF_INCLUDE:-} ]] || llamacpp_die "HF_INCLUDE is not set in $MODEL_CONFIG"

HF_LOCAL_DIR=${HF_LOCAL_DIR:-models/$MODEL_NAME/hf}
if [[ $HF_LOCAL_DIR != /* ]]; then
  HF_LOCAL_DIR="$ROOT_DIR/$HF_LOCAL_DIR"
fi

mkdir -p "$HF_LOCAL_DIR"

HF_CLI=$(llamacpp_ensure_hf_cli)
DOWNLOAD_ARGS=("$HF_REPO")
read -r -a HF_INCLUDES <<< "$HF_INCLUDE"
for include in "${HF_INCLUDES[@]}"; do
  DOWNLOAD_ARGS+=(--include "$include")
done
DOWNLOAD_ARGS+=(--local-dir "$HF_LOCAL_DIR")

"$HF_CLI" download "${DOWNLOAD_ARGS[@]}"

if [[ -n ${MODEL_GGUF:-} && -n ${MODEL_GGUF_SOURCE:-} ]]; then
  MODEL_GGUF_PATH=$MODEL_GGUF
  MODEL_GGUF_SOURCE_PATH=$MODEL_GGUF_SOURCE

  if [[ $MODEL_GGUF_PATH != /* ]]; then
    MODEL_GGUF_PATH="$ROOT_DIR/$MODEL_GGUF_PATH"
  fi
  if [[ $MODEL_GGUF_SOURCE_PATH != /* ]]; then
    MODEL_GGUF_SOURCE_PATH="$ROOT_DIR/$MODEL_GGUF_SOURCE_PATH"
  fi

  [[ -e $MODEL_GGUF_SOURCE_PATH ]] || llamacpp_die "download finished, but MODEL_GGUF_SOURCE does not exist: $MODEL_GGUF_SOURCE_PATH"

  SOURCE_BASENAME=$(basename "$MODEL_GGUF_SOURCE_PATH")
  TARGET_BASENAME=$(basename "$MODEL_GGUF_PATH")
  if [[ $SOURCE_BASENAME =~ -[0-9]{5}-of-[0-9]{5}\.gguf$ &&
        ! $TARGET_BASENAME =~ -[0-9]{5}-of-[0-9]{5}\.gguf$ ]]; then
    llamacpp_die "split GGUF aliases must keep the shard filename pattern; use $SOURCE_BASENAME instead of $TARGET_BASENAME"
  fi

  if [[ $MODEL_GGUF_PATH != "$MODEL_GGUF_SOURCE_PATH" ]]; then
    mkdir -p "$(dirname "$MODEL_GGUF_PATH")"
    ln -sfn "$MODEL_GGUF_SOURCE_PATH" "$MODEL_GGUF_PATH"
    echo "lLLM-AWAY-remote: model alias updated: $MODEL_GGUF_PATH -> $MODEL_GGUF_SOURCE_PATH"
  fi
fi
