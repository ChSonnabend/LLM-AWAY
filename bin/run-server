#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$SCRIPT_DIR/.." && pwd)

source "$ROOT_DIR/scripts/lib/llamacpp-env.sh"

llamacpp_load_model_config "${MODEL_NAME:-$LLAMACPP_DEFAULT_MODEL}"

BACKEND=$(llamacpp_detect_backend)
llamacpp_export_visible_devices "$BACKEND"
GPU_COUNT=${LLAMACPP_GPU_COUNT:-$(llamacpp_gpu_count "$BACKEND")}

MODEL_PATH=$(llamacpp_resolve_model)
LLAMA_SERVER=$(llamacpp_binary server "$BACKEND")

ARGS=(
  -m "$MODEL_PATH"
  --alias "$MODEL_ALIAS"
  --host "${LLAMACPP_HOST:-${HOST:-127.0.0.1}}"
  --port "${LLAMACPP_PORT:-${PORT:-8080}}"
  --parallel "${LLAMACPP_PARALLEL:-${PARALLEL:-1}}"
)
while IFS= read -r arg; do
  ARGS+=("$arg")
done < <(llamacpp_common_run_args "$BACKEND" "$GPU_COUNT")

exec "$LLAMA_SERVER" "${ARGS[@]}" "$@"
