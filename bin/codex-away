#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().parent.parent)' "${BASH_SOURCE[0]}")"
config="${LLM_REMOTE_CONFIG:-$repo_dir/config/away.toml}"
host="${LLM_REMOTE_HOST:-127.0.0.1}"
port="${LLM_REMOTE_PORT:-8765}"
log_dir="${XDG_RUNTIME_DIR:-/tmp}"
log_path="${LLM_REMOTE_PROVIDER_LOG:-$log_dir/llm-away-provider-${USER:-user}.log}"
provider_pid=""
# Default to owning the provider so /exit and Ctrl+C cleanly tear down the Slurm job.
restart_provider="${LLM_REMOTE_RESTART_PROVIDER:-1}"
tty_state="$(stty -g 2>/dev/null || true)"

healthcheck() {
    python3 - "$host" "$port" <<'PY' >/dev/null 2>&1
import sys
from urllib.request import urlopen

host, port = sys.argv[1], sys.argv[2]
with urlopen(f"http://{host}:{port}/health", timeout=1) as response:
    sys.exit(0 if response.status < 500 else 1)
PY
}

restore_terminal() {
    if [[ -n "$tty_state" && -r /dev/tty && -w /dev/tty ]]; then
        stty "$tty_state" </dev/tty 2>/dev/null || stty sane </dev/tty 2>/dev/null || true
    fi
}

cleanup() {
    trap "" INT TERM
    if [[ -n "$provider_pid" ]] && kill -0 "$provider_pid" 2>/dev/null; then
        kill "$provider_pid" 2>/dev/null || true
        wait "$provider_pid" 2>/dev/null || true
    fi
    restore_terminal
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

stop_existing_provider() {
    python3 - "$config" <<'PY'
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

# BSD/macOS and Linux ps both support these options; only inspect our user.
listing = subprocess.check_output(
    ["ps", "-ww", "-U", str(os.getuid()), "-o", "pid=", "-o", "args="],
    universal_newlines=True,
)
pids = []
for line in listing.splitlines():
    fields = line.strip().split(None, 1)
    if len(fields) != 2:
        continue
    pid, command = fields
    # ps prints arguments without shell quoting, including paths with spaces.
    marker = " -m llm_away.cli serve --config " + str(Path(sys.argv[1]).resolve())
    if marker not in command:
        continue
    suffix = command.split(marker, 1)[1]
    if suffix and not suffix.startswith(" "):
        continue
    pids.append(int(pid))

for pid in pids:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass

deadline = time.monotonic() + 60
while pids and time.monotonic() < deadline:
    alive = []
    for pid in pids:
        try:
            os.kill(pid, 0)
            alive.append(pid)
        except ProcessLookupError:
            pass
    pids = alive
    if pids:
        time.sleep(0.1)
if pids:
    sys.exit("Provider is still cleaning up; wait before restarting it.")

PY
}

if [[ "$restart_provider" == "1" ]] && healthcheck; then
    echo "llm-away: stopping existing local provider on http://$host:$port" >&2
    stop_existing_provider
    sleep 0.2
fi

if ! healthcheck; then
    echo "llm-away: starting local provider on http://$host:$port (log: $log_path)" >&2
    host_args=()
    if [[ -n "${REMOTE_HOST:-}" ]]; then
        host_args=(--host "$REMOTE_HOST")
    fi
    "$repo_dir/bin/llm-away" serve --config "$config" "${host_args[@]+${host_args[@]}}" >"$log_path" 2>&1 &
    provider_pid=$!
    for ((attempt = 0; attempt < 50; attempt++)); do
        if healthcheck; then
            break
        fi
        if ! kill -0 "$provider_pid" 2>/dev/null; then
            echo "llm-away: provider exited during startup; log follows:" >&2
            sed -n '1,200p' "$log_path" >&2 || true
            exit 1
        fi
        sleep 0.1
    done
    if ! healthcheck; then
        echo "llm-away: provider did not become healthy; log follows:" >&2
        sed -n '1,200p' "$log_path" >&2 || true
        exit 1
    fi
else
    echo "llm-away: reusing existing local provider on http://$host:$port" >&2
fi

if [[ -t 1 ]]; then
    codex --no-alt-screen --profile away "$@"
elif [[ -r /dev/tty && -w /dev/tty ]]; then
    exec </dev/tty >/dev/tty 2>&1
    codex --no-alt-screen --profile away "$@"
else
    echo "llm-away: stdout is not a terminal and /dev/tty is unavailable" >&2
    exit 1
fi
