#!/usr/bin/env bash
set -euo pipefail
ROOT="$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().parent.parent)' "${BASH_SOURCE[0]}")"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
# Keep the session's model loaded and return to the shell without launching Codex.
exec python3 -m llm_away.resources run --serve "$@"
