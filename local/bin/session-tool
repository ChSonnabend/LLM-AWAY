#!/usr/bin/env bash
set -euo pipefail

_AWAY_ENTRY="${BASH_SOURCE[0]}"
while [[ -L "$_AWAY_ENTRY" ]]; do
    _AWAY_DIR="$(cd -P "$(dirname "$_AWAY_ENTRY")" && pwd)"
    _AWAY_ENTRY="$(readlink "$_AWAY_ENTRY")"
    [[ $_AWAY_ENTRY = /* ]] || _AWAY_ENTRY="$_AWAY_DIR/$_AWAY_ENTRY"
done
source "$(cd -P "$(dirname "$_AWAY_ENTRY")/../scripts" && pwd)/env.sh"
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
# Dependency installation must never write to the MCP protocol's stdout.
PYTHON="$(python3 -c 'import os; from llm_away.rag import runtime
output=os.dup(1); os.dup2(2,1)
p=runtime()
os.write(output,(str(p)+"\n").encode())')"
exec "$PYTHON" -m llm_away.session_tool "$@"
