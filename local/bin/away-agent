#!/usr/bin/env bash
set -euo pipefail

_AWAY_ENTRY="${BASH_SOURCE[0]}"
while [[ -L "$_AWAY_ENTRY" ]]; do
    _AWAY_DIR="$(cd -P "$(dirname "$_AWAY_ENTRY")" && pwd)"
    _AWAY_ENTRY="$(readlink "$_AWAY_ENTRY")"
    [[ $_AWAY_ENTRY = /* ]] || _AWAY_ENTRY="$_AWAY_DIR/$_AWAY_ENTRY"
done
source "$(cd -P "$(dirname "$_AWAY_ENTRY")/../scripts" && pwd)/env.sh"

repo_dir="$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().parent.parent)' "${BASH_SOURCE[0]}")"
config="${LLM_REMOTE_CONFIG:-$repo_dir/config/model.toml}"
tty_state="$(stty -g 2>/dev/null || true)"

restore_terminal() {
    if [[ -n "$tty_state" && -r /dev/tty && -w /dev/tty ]]; then
        stty "$tty_state" </dev/tty 2>/dev/null || stty sane </dev/tty 2>/dev/null || true
    fi
}

cleanup() {
    trap "" INT TERM
    restore_terminal
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

args=(serve --config "$config")
if [[ -n "${REMOTE_PORT:-}" ]]; then
    args+=(--port "$REMOTE_PORT")
fi
if [[ -n "${REMOTE_HOST:-}" ]]; then
    args+=(--host "$REMOTE_HOST")
fi
if [[ -n "${REMOTE_SLURM_JOB:-}" ]]; then
    args+=(--slurm-job "$REMOTE_SLURM_JOB")
fi
if [[ -n "${REMOTE_NODES:-}" ]]; then
    args+=(--nodes "$REMOTE_NODES")
fi
if [[ -n "${REMOTE_GPUS:-}" ]]; then
    args+=(--gpus "$REMOTE_GPUS")
fi
args+=(--warm)
"$repo_dir/bin/llm-away" "${args[@]}"
