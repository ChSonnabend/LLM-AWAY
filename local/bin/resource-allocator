#!/usr/bin/env bash
set -euo pipefail

_AWAY_ENTRY="${BASH_SOURCE[0]}"
while [[ -L "$_AWAY_ENTRY" ]]; do
    _AWAY_DIR="$(cd -P "$(dirname "$_AWAY_ENTRY")" && pwd)"
    _AWAY_ENTRY="$(readlink "$_AWAY_ENTRY")"
    [[ $_AWAY_ENTRY = /* ]] || _AWAY_ENTRY="$_AWAY_DIR/$_AWAY_ENTRY"
done
source "$(cd -P "$(dirname "$_AWAY_ENTRY")/../scripts" && pwd)/env.sh"
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
# Interactive allocation menus need a terminal stdout; some terminal wrappers
# pipe stdout while keeping stdin on the controlling TTY.
if [[ -t 0 && ! -t 1 && -r /dev/tty && -w /dev/tty ]]; then
    exec </dev/tty >/dev/tty 2>&1
fi
exec python3 -m llm_away.resources allocate "$@"
