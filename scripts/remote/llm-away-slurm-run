#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: llm-away-slurm-run --json < payload.json" >&2
}

if [[ "${1:-}" != "--json" ]]; then
    usage
    exit 2
fi

payload="$(cat)"

python3 - "$payload" <<'PY'
import json
import os
import shlex
import subprocess
import sys

payload = json.loads(sys.argv[1])
llama = payload["llamacpp"]
mtp = llama.get("mtp", "auto")
if mtp not in ("auto", "on", "off"):
    sys.exit("invalid MTP mode; expected auto, on, or off")

def q(value):
    return shlex.quote(str(value))

def rocm_arch_command():
    if llama.get("backend") == "cuda":
        return "export LLAMACPP_ROCM_ARCH=unused"
    arch = llama.get("rocm_arch", "auto")
    if arch != "auto":
        return "export LLAMACPP_ROCM_ARCH=" + q(arch)
    return (
        "case $(hostname -s) in "
        "epn[0-1][0-9][0-9]|epn2[0-6][0-9]|epn27[0-9]) export LLAMACPP_ROCM_ARCH=gfx906 ;; "
        "epn28[0-9]|epn29[0-9]|epn3[0-4][0-9]) export LLAMACPP_ROCM_ARCH=gfx908 ;; "
        "*) export LLAMACPP_ROCM_ARCH=$(rocminfo 2>/dev/null | grep -m1 -o 'gfx[0-9][0-9][0-9]*' || echo gfx908) ;; "
        "esac"
    )

def progress_static(message):
    return "echo " + q("llm-away: " + message) + " >&2"

def node_options():
    partition = payload.get("partition", "prod")
    opts = ["srun"]
    gpus = int(payload.get("gpus") or 0)
    opts.extend(["--nodes=" + str(payload.get("nodes") or 1), "--ntasks=1"])
    if gpus:
        opts.append("--gres=gpu:" + str(gpus))
    if not gpus and payload.get("exclusive", True):
        opts.append("--exclusive")
    opts.extend(["-p", partition])

    custom = payload.get("custom_options") or []
    node_class = payload.get("node_class", "")
    if custom:
        opts.extend(custom)
    elif node_class == "mi50":
        # Match the user's shell function: epn000..epn278.
        opts.extend(["-w", "$(printf 'epn%03d' $(( RANDOM % 279 )))"])
    elif node_class == "mi100":
        # Match the user's shell function: epn280..epn349 and export marker.
        opts.extend(["-w", "$(printf 'epn%03d' $(( 280 + RANDOM % 70 )))", "--export=ALL,REMOTE_NODE_MI100=1"])
    elif node_class:
        opts.extend(["-w", node_class])
    return opts

setup = [
    'echo "llm-away: allocated $(hostname -s)" >&2',
    f"cd {q(payload['remote_workdir'])}",
    f"export MODEL_NAME={q(llama.get('model_name') or payload['model'])}",
    f"export LLAMACPP_MTP={q(mtp)}",
    f"export LLAMACPP_BACKEND={q(llama.get('backend', 'rocm'))}",
    f"export LLAMACPP_CONTAINER={q(llama.get('container', ''))}",
    rocm_arch_command(),
    'echo "llm-away: using ROCm arch $LLAMACPP_ROCM_ARCH" >&2',
    f"export LLAMACPP_VISIBLE_DEVICES={q(llama.get('visible_devices', '0,1,2,3,4,5,6,7'))}",
]
if payload.get("gpus"):
    setup.append('export LLAMACPP_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-}"' if llama.get("backend") == "cuda" else 'export LLAMACPP_VISIBLE_DEVICES="${ROCR_VISIBLE_DEVICES:-${HIP_VISIBLE_DEVICES:-}}"')
if mtp != "auto":
    setup.append("source scripts/lib/llamacpp-env.sh")
    setup.append("{ declare -F llamacpp_apply_mtp_mode >/dev/null || "
                 "{ echo 'Remote wrapper lacks LLAMACPP_MTP support' >&2; exit 2; }; }")
if llama.get("build_before_run"):
    setup.append(progress_static("building llama.cpp"))
    setup.append("bin/build-llama >&2")
if llama.get("show_config_before_run"):
    setup.append(progress_static("showing config"))
    setup.append("bin/show-config >&2")
if llama.get("list_devices_before_run"):
    setup.append(progress_static("listing devices"))
    setup.append("bin/list-devices >&2")

run = [llama.get("run_cli", "bin/run-cli"), "-p", payload["prompt"]]
run.extend(llama.get("extra_args") or [])
setup.append(progress_static("running inference"))
timeout_seconds = int(llama.get("inference_timeout_seconds", 300))
run_shell = " ".join(q(arg) for arg in run) + " < /dev/null"
if timeout_seconds > 0:
    timed = "timeout --foreground " + q(timeout_seconds) + " /bin/bash -lc " + q(run_shell)
    setup.append(
        timed
        + " || { status=$?; "
        + "if [ \"$status\" -eq 124 ]; then echo "
        + q("llm-away: inference timed out; run_cli may be interactive/REPL-only")
        + " >&2; fi; exit \"$status\"; }"
    )
else:
    setup.append(run_shell)
inner = " && ".join(setup)

image = llama.get("container", "")
if image:
    subprocess.check_call([
        sys.executable,
        os.path.join(payload["remote_workdir"], "scripts/remote/ensure-container.py"),
        image, llama.get("container_source", ""),
    ], stdout=sys.stderr)

srun = node_options()
cmd = " ".join(srun) + " /bin/bash -lc " + q(inner)
sys.stderr.write("llm-away: submitting Slurm job\n")
sys.stderr.flush()
if payload.get("debug"):
    sys.stderr.write("llm-away remote command: " + cmd + "\n")
    sys.stderr.flush()

completed = subprocess.Popen(
    cmd,
    shell=True,
    stdout=subprocess.PIPE,
    stderr=None,
    universal_newlines=True,
)
stdout, _ = completed.communicate()
if completed.returncode:
    sys.exit(completed.returncode)
sys.stdout.write(stdout)
PY
