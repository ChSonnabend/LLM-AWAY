MODEL_ALIAS=qwen3.8-27b-q4km
MODEL_GGUF=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
MODEL_GGUF_SOURCE=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
MODEL_DRAFT_GGUF=models/Qwen3.8-27B-GGUF/mtp-Qwen3.8-27B-Q4_0.gguf

HF_REPO=ggml-org/Qwen3.8-27B-GGUF
HF_INCLUDE="Qwen3.8-27B-Q4_K_M.gguf mtp-Qwen3.8-27B-Q4_0.gguf"
