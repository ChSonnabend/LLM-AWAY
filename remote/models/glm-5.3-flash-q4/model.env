MODEL_ALIAS=glm-5.3-flash-q4
MODEL_GGUF=models/GLM-5.3-Flash-GGUF/UD-Q4_K_XL/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf
MODEL_GGUF_SOURCE=$MODEL_GGUF
HF_REPO=unsloth/GLM-5.3-Flash-GGUF
HF_INCLUDE='UD-Q4_K_XL/*.gguf'
HF_LOCAL_DIR=models/GLM-5.3-Flash-GGUF
MODEL_MTP_EMBEDDED=1
LLAMACPP_SPEC_DRAFT_N_MAX=2
# Downloaded revision: 621d456e93e926e4b52f85cff5f634358c1828f9
# CUDA H200 runtime, pinned to llama.cpp GLM5-Next support (PR 27754).
_glm_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
export LLAMACPP_MODEL_CUDA_SERVER="$_glm_root/builds/glm5next/build/bin/llama-server"
unset _glm_root
MODEL_CONTEXT_SIZE=750000
LLAMACPP_CTX_SIZE=$MODEL_CONTEXT_SIZE
LLAMACPP_SPLIT_MODE=layer
LLAMACPP_EXTRA_ARGS='--jinja --temp 1.0 --top-p 0.95 --min-p 0.01'
# Host defaults previously disabled reasoning and quantized both cache types.
LLAMACPP_SERVER_EXTRA_ARGS='--ctx-size 750000 --reasoning on --flash-attn on --cache-type-k f16 --cache-type-v f16 --batch-size 2048 --ubatch-size 1024'
