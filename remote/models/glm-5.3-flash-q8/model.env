MODEL_ALIAS=glm-5.3-flash-q8
MODEL_GGUF=models/GLM-5.3-Flash-GGUF/Q8_0/GLM-5.3-Flash-Q8_0-00001-of-00008.gguf
MODEL_GGUF_SOURCE=$MODEL_GGUF
HF_REPO=unsloth/GLM-5.3-Flash-GGUF
HF_INCLUDE="Q8_0/*.gguf"
HF_LOCAL_DIR=models/GLM-5.3-Flash-GGUF
MODEL_MTP_EMBEDDED=1
LLAMACPP_SPEC_DRAFT_N_MAX=2
_glm_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
export LLAMA_SERVER="$_glm_root/builds/glm5next/build/bin/llama-server"
unset _glm_root
MODEL_CONTEXT_SIZE=1000000
LLAMACPP_CTX_SIZE=$MODEL_CONTEXT_SIZE
LLAMACPP_SPLIT_MODE=layer
LLAMACPP_EXTRA_ARGS="--jinja --temp 1.0 --top-p 0.95 --min-p 0.01"
LLAMACPP_SERVER_EXTRA_ARGS="--ctx-size 1000000 --reasoning on --flash-attn on --cache-type-k f16 --cache-type-v f16 --batch-size 8192 --ubatch-size 8192"
