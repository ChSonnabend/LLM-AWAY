#!/usr/bin/env bash
# Build a new versioned image; never overwrite a running container.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
kind=${1:-training}
case "$kind" in
  unified) recipe=llm-away-cuda ;;
  training) recipe=unsloth-training-cuda ;;
  cuda) recipe=llama-server-cuda ;;
  rocm) recipe=llama-server-rocm ;;
  cuda-devel) recipe=cuda-devel ;;
  *) echo 'Usage: build-container [unified|training|cuda|rocm|cuda-devel] [NEW_OUTPUT.sif] [GPU_JOB_ID_FOR_TRAINING_TEST]' >&2; exit 2 ;;
esac
output=${2:-"$root/containers/$recipe-$(date -u +%Y%m%dT%H%M%SZ).sif"}
[[ ! -e "$output" ]] || { echo "Refusing to overwrite existing image: $output" >&2; exit 1; }
mkdir -p "$(dirname "$output")"
output=$(cd "$(dirname "$output")" && pwd)/$(basename "$output")
command -v apptainer >/dev/null
scratch=$(mktemp -d "${TMPDIR:-/tmp}/llm-away-build.XXXXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
export APPTAINER_TMPDIR="$scratch"
build_args=()
if [[ "$kind" == unified ]]; then
  training_image=${TRAINING_IMAGE:-$root/containers/unsloth-training-cuda.sif}
  inference_image=${INFERENCE_IMAGE:-$root/containers/llama-server-cuda.sif}
  glm_server=${GLM_SERVER:-$root/builds/glm5next/build/bin/llama-server}
  for input in "$training_image" "$inference_image" "$glm_server"; do
    [[ -r "$input" ]] || { echo "Missing unified-image build input: $input" >&2; exit 1; }
  done
  build_args+=(--build-arg "training_image=$training_image" --build-arg "inference_image=$inference_image" --build-arg "glm_server=$glm_server")
fi
apptainer build "${build_args[@]}" --fakeroot --mksquashfs-args "-processors ${BUILD_CPUS:-4}" "$scratch/image.sif" "$root/containers/$recipe.def"
if [[ ( "$kind" == training || "$kind" == unified ) && -n "${3:-}" ]]; then
  # The image must be on shared storage for the GPU node.
  staged="$output.testing.sif"
  [[ ! -e "$staged" ]] || { echo "Validation image already exists: $staged" >&2; exit 1; }
  cp -n "$scratch/image.sif" "$staged"
  if ! srun --jobid="$3" --overlap --exact --ntasks=1 --cpus-per-task=2 --chdir="$root" \
      apptainer exec --nv --bind "$root" "$staged" /opt/unsloth-venv/bin/python "$root/training/check_causal_conv1d.py"; then
    echo "Validation failed; unpublished image retained at $staged" >&2; exit 1
  fi
  if [[ "$kind" == unified ]]; then
    for server in /app/llama-server /opt/llm-away/glm5next/llama-server; do
      srun --jobid="$3" --overlap --exact --ntasks=1 --cpus-per-task=2 --chdir="$root" \
        apptainer exec --nv "$staged" "$server" --list-devices
    done
  fi
  mv -n "$staged" "$output"
else
  cp -n "$scratch/image.sif" "$output"
fi
apptainer inspect --deffile "$output" > "$output.def"
echo "Built $output (definition: $output.def)"
