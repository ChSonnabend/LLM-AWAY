#!/usr/bin/env python3
"""Sample GPUs inside an allocation; publish atomically without SSH polling."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time


def sample():
    if shutil.which('nvidia-smi'):
        command=['nvidia-smi','--query-gpu=index,uuid,name,memory.used,memory.total,utilization.gpu','--format=csv']
    elif shutil.which('rocm-smi'):
        command=['rocm-smi','--showproductname','--showmeminfo','vram','--showuse']
    else:
        return {'timestamp':time.time(),'error':'Neither nvidia-smi nor rocm-smi is available.'}
    try:
        result=subprocess.run(command,stdout=subprocess.PIPE,stderr=subprocess.PIPE,universal_newlines=True,timeout=8)
        return {'timestamp':time.time(),'lines':result.stdout.splitlines(),
                'error':result.stderr.strip() if result.returncode else ''}
    except (OSError,subprocess.TimeoutExpired) as exc:
        return {'timestamp':time.time(),'error':str(exc)}


def main():
    state=Path(sys.argv[1])
    while not (state/'release').exists():
        heartbeat=state/'heartbeat'
        if not heartbeat.exists() or time.time()-heartbeat.stat().st_mtime>60:break
        data=sample()
        temp=state/('gpu.'+str(os.getpid())+'.tmp')
        temp.write_text(json.dumps(data));os.replace(str(temp),str(state/'gpu.json'))
        time.sleep(5)


if __name__=='__main__':main()
