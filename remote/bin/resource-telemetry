#!/usr/bin/env python3
"""Sample GPUs inside an allocation; publish atomically without SSH polling."""
import csv
import io
import json
import os
import re
from pathlib import Path
import shutil
import subprocess
import sys
import time


def rocm_sample():
    """Normalize rocm-smi output to the nvidia-smi CSV format."""
    result=subprocess.run(['rocm-smi','--showproductname','--showmeminfo','vram','--showuse'],
                          stdout=subprocess.PIPE,stderr=subprocess.PIPE,universal_newlines=True,timeout=8)
    text=result.stdout
    names={}
    for match in re.finditer(r'GPU\[(\d+)\]\s*:\s*Card Series:\s*(.+)',text):
        names[int(match.group(1))]=match.group(2).strip()
    memory={}
    for match in re.finditer(r'GPU\[(\d+)\]\s*:\s*VRAM Total Memory \(B\):\s*(\d+)',text):
        memory.setdefault(int(match.group(1)),{})['total']=int(match.group(2))
    for match in re.finditer(r'GPU\[(\d+)\]\s*:\s*VRAM Total Used Memory \(B\):\s*(\d+)',text):
        memory.setdefault(int(match.group(1)),{})['used']=int(match.group(2))
    use={}
    for match in re.finditer(r'GPU\[(\d+)\]\s*:\s*GPU use \(%\):\s*(\d+)',text):
        use[int(match.group(1))]=int(match.group(2))
    output=io.StringIO()
    writer=csv.writer(output)
    writer.writerow(['index','uuid','name','memory.used [MiB]','memory.total [MiB]','utilization.gpu [%]'])
    for index in sorted(set(names)|set(memory)|set(use)):
        info=memory.get(index,{})
        name=names.get(index,'AMD GPU')
        writer.writerow([index,'',name,round(info.get('used',0)/1048576),round(info.get('total',0)/1048576),use.get(index,0)])
    if len(output.getvalue().splitlines())<=1:
        raise ValueError('No GPU data in rocm-smi output')
    return output.getvalue()


def sample():
    if shutil.which('nvidia-smi'):
        command=['nvidia-smi','--query-gpu=index,uuid,name,memory.used,memory.total,utilization.gpu','--format=csv']
    elif shutil.which('rocm-smi'):
        try:
            return {'timestamp':time.time(),'lines':rocm_sample().splitlines(),'error':''}
        except (OSError,ValueError,subprocess.TimeoutExpired) as exc:
            return {'timestamp':time.time(),'lines':[],'error':str(exc)}
    else:
        return {'timestamp':time.time(),'lines':[],'error':'Neither nvidia-smi nor rocm-smi is available.'}
def main():
    state=Path(sys.argv[1])
    while not (state/'release').exists():
        heartbeat=state/'heartbeat'
        if not heartbeat.exists() or time.time()-heartbeat.stat().st_mtime>60:break
        data=sample()
        temp=state/('gpu.'+str(os.getpid())+'.tmp')
        temp.write_text(json.dumps(data));os.replace(str(temp),str(state/'gpu.json'))
        time.sleep(5)


if __name__=='__main__':main()
