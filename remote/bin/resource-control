#!/usr/bin/env python3
"""Persistent resource reservations, independent of the model process (Python 3.6+)."""
import datetime, fcntl, hashlib, json, os, re, shlex, shutil, subprocess, sys, time, uuid
from pathlib import Path

p=json.load(sys.stdin)
action=sys.argv[1]
c=p['config']; token=p['token']
if not re.fullmatch('[a-f0-9]{32}',token): raise ValueError('Invalid resource token')
root=Path(c['remote']['workdir']).resolve()
resource_base=c['remote'].get('resource_state_dir', '')
if resource_base:
    base=Path(os.path.expandvars(resource_base)).expanduser().resolve()
    if action not in ('cleanup','cleanup-preview'): base.mkdir(parents=True,exist_ok=True,mode=0o700)
    if base.exists() and base.stat().st_uid != os.getuid():
        raise ValueError('Resource state directory must belong to the current user: '+str(base))
    state=base/'resources'/token
else:
    # Existing allocations must remain addressable after updating the scripts.
    state=root/'.state'/'resources'/token
if action in ('cleanup','cleanup-preview'):
    if state.is_symlink() or state.parent.is_symlink():
        raise ValueError('Refusing symlinked resource state')
    if not state.exists():
        print(json.dumps({'cleaned':True,'already_missing':True,'paths':[]})); sys.exit(0)
    if state.stat().st_uid != os.getuid():
        raise ValueError('Resource state belongs to another user')
elif action!='list':
    state.mkdir(parents=True,exist_ok=True,mode=0o700)
kind=c['backend_type']; k=c['kubernetes']; sl=c['slurm']
meta=state/'allocation.json'

def client_state():
    identifier=p.get('client_id','')
    if not identifier:raise ValueError('Client identity required')
    return state/'clients'/hashlib.sha256(identifier.encode()).hexdigest()[:16]


def job_label():
    number=p.get('session_id')
    return 'model-'+(str(int(number)) if number is not None else token[:8])


def write(path,value):
    temp=Path(str(path)+'.tmp'); temp.write_text(value); os.replace(str(temp),str(path))
def call(args, data=None):
    r=subprocess.run(args,input=data,stdout=subprocess.PIPE,stderr=subprocess.PIPE,universal_newlines=True,timeout=60)
    if r.returncode: raise RuntimeError(r.stderr.strip() or r.stdout.strip())
    return r.stdout.strip()
def kubectl(args,data=None):
    base=['kubectl']+(['--context',k['context']] if k['context'] else [])+['--namespace',k['namespace']]
    return call(base+args,data)
def status():
    s=json.loads(meta.read_text()) if meta.exists() else {}
    s.update(active=False,slurm_state='STOPPED',host='',model_state='IDLE')
    if not s.get('job_id'): return s
    if kind=='slurm_server':
        try: out=call(['squeue','-h','-j',s['job_id'],'-o','%T|%N|%r'])
        except RuntimeError as e:
            if 'Invalid job id' not in str(e): raise
            out=''
        if out:
            phase,host,reason=out.splitlines()[0].split('|',2)
            s.update(active=phase in ('PENDING','RUNNING','CONFIGURING','COMPLETING'),slurm_state=phase,reason=reason)
            if phase=='RUNNING': s['host']=host
            try:
                end_raw=call(['squeue','-h','-j',s['job_id'],'-o','%e']).splitlines()[0]
                if end_raw in ('NONE','UNLIMITED',''):s['time_left_seconds']=None
                else:s['time_left_seconds']=max(0,int((datetime.datetime.fromtimestamp(time.mktime(time.strptime(end_raw,'%Y-%m-%dT%H:%M:%S')))-datetime.datetime.now()).total_seconds()))
            except (RuntimeError,IndexError,ValueError):s['time_left_seconds']=None
        else:
            # Missing from squeue is not proof of termination (accounting may lag).
            s['slurm_state']='UNKNOWN'
            try:
                accounting=call(['sacct','-n','-P','-j',s['job_id'],'--format=JobIDRaw,State'])
            except RuntimeError:
                # Clusters without accounting: an unknown job that no longer
                # appears in squeue is treated as ended.
                s['slurm_state']='CANCELLED'
            else:
                for line in accounting.splitlines():
                    fields=line.split('|')
                    if len(fields)>1 and fields[0].strip()==str(s['job_id']):
                        s['slurm_state']=fields[1].strip().split()[0].rstrip('+')
                        break
    elif kind=='kubernetes':
        raw=kubectl(['get','job',s['job_id'],'--ignore-not-found','-o','json'])
        if raw:
            job=json.loads(raw)
            labels=job['metadata'].get('labels',{})
            if labels.get('llm-remote-resource',labels.get('llm-away-resource'))!=token: raise RuntimeError('Job ownership mismatch')
            deadline=job.get('spec',{}).get('activeDeadlineSeconds')
            if deadline is None:s['time_left_seconds']=None
            else:
                started=job.get('status',{}).get('startTime')
                if started:s['time_left_seconds']=max(0,deadline-int((datetime.datetime.now(datetime.timezone.utc)-datetime.datetime.fromisoformat(started.replace('Z','+00:00'))).total_seconds()))
                else:s['time_left_seconds']=deadline
            s.update(active=not any(x.get('status')=='True' and x.get('type') in ('Complete','Failed') for x in job.get('status',{}).get('conditions',[])),slurm_state='PENDING')
            pods=json.loads(kubectl(['get','pods','-l','job-name='+s['job_id'],'-o','json']))['items']
            if pods:
                pod=pods[-1]; phase=pod.get('status',{}).get('phase','Pending')
                s['slurm_state']=phase.upper()
                if phase=='Running': s['host']=pod['metadata']['name']
                if phase in ('Failed','Succeeded'): s['active']=False
    else:
        heartbeat=state/'heartbeat'
        active=time.time()-(heartbeat.stat().st_mtime if heartbeat.exists() else s['created'])<20
        s.update(active=active,slurm_state='RUNNING' if active else 'STOPPED',host='127.0.0.1')
    if 'time_left_seconds' not in s:s['time_left_seconds']=None
    wf=state/'worker.state'
    if wf.exists():
        fields=wf.read_text().split()
        if len(fields)==3: s.update(generation=fields[0],model_state=fields[1])
        if len(fields)==2: s['model_state']=fields[0] # initial IDLE before first request
    if kind=='direct' and s.get('model_state')=='STOPPED': s.update(active=False,slurm_state='STOPPED')
    desired=state/'desired'
    if desired.exists():
        requested=desired.read_text().strip()
        if requested and requested!=s.get('generation'):
            s.update(model_state='STARTING' if (state/(requested+'.sh')).exists() else 'STOPPING',generation=requested)
    # Older workers never promote LOADING. Check the live server so discovered
    # allocations report readiness without requiring their model to be restarted.
    if s.get('active') and s.get('model_state')=='LOADING' and kind in ('direct','slurm_server') and s.get('host'):
        try:
            from urllib.request import build_opener, ProxyHandler
            url='http://%s:%s/health' % (s['host'],s.get('server_port',p['port']))
            with build_opener(ProxyHandler({})).open(url,timeout=1) as response:
                if response.status==200 and json.load(response).get('status')=='ok':s['model_state']='LOADED'
        except Exception:pass
    telemetry=state/'gpu.json'
    if telemetry.exists():
        try:s['gpu_telemetry']=json.loads(telemetry.read_text())
        except (OSError,ValueError):pass
    rag_log=client_state()/'rag.log' if p.get('client_id') else state/'rag.log'
    if rag_log.exists():
        try:s['rag_log']=rag_log.read_text(errors='replace')[-262144:]
        except OSError:pass
    latest=state/'prompt-latest'
    if latest.exists():
        prompt_id=latest.read_text().strip()
        if re.fullmatch('[a-f0-9]{32}',prompt_id):
            result=state/'prompts'/(prompt_id+'.result')
            s['prompt']=json.loads(result.read_text()) if result.exists() else {'id':prompt_id,'status':'QUEUED','text':''}
            s['prompt']['text']=s['prompt'].get('text','')[-32768:]
    terminal=client_state()/'terminal-status.json' if p.get('client_id') else state/'terminal-status.json'
    if terminal.exists():s['terminal']=json.loads(terminal.read_text())
    owner=state/'owner.json'
    s['owner']=json.loads(owner.read_text()) if owner.exists() else {}
    descriptor=state/'session.json'
    if descriptor.exists():s['session']=json.loads(descriptor.read_text())
    attached=client_state()/'attachment.json' if p.get('client_id') else state/'attachment.json'
    s['attachment']=json.loads(attached.read_text()) if attached.exists() else {}
    registry=state/'rags.json'
    s['remote_rags']=json.loads(registry.read_text()) if registry.exists() else {}
    s['log_path']=str(state/'model.log')
    return s

def descriptor():
    # Store remote execution settings only; local credentials and ports stay local.
    return {key:c[key] for key in ('backend_type','remote','slurm','kubernetes','model','llamacpp')}

def save_descriptor():
    write(state/'session.json',json.dumps(descriptor()))

def require_owner():
    path=state/'owner.json'
    owner=json.loads(path.read_text()) if path.exists() else {}
    if owner and owner.get('id')!=p.get('client_id'):
        raise ValueError('Session allocated on '+owner.get('label','another machine')+'; acknowledge takeover first')
    return owner

def attach():
    current=status()
    if not current.get('active') or current.get('model_state') not in ('STARTING','LOADING','LOADED','READY'):
        raise ValueError('No running model to attach to')
    if not p.get('expected_generation') or p['expected_generation']!=current.get('generation'):
        raise ValueError('Session changed; refresh before attaching')
    target=client_state();target.mkdir(parents=True,exist_ok=True,mode=0o700)
    write(target/'attachment.json',json.dumps({'generation':current['generation']}))
    return status()


def require_attachment():
    current=status()
    if current.get('active') and current.get('model_state') in ('STARTING','LOADING','LOADED','READY'):
        if current.get('owner',{}).get('id')==p.get('client_id'):return
        if current.get('attachment',{}).get('generation')==current.get('generation'):return
    raise ValueError('Session changed; attach to the running model first')


def register_rag():
    config=dict(p['rag_config'])
    if config.get('compute')!='remote' or config.get('paths_location') not in ('remote','shared'):
        raise ValueError('Only remote RAG compute with remote or shared paths can be shared')
    if not config.get('paths') or not all(isinstance(path,str) and path.startswith('/') for path in config['paths']):
        raise ValueError('Shared RAG requires absolute remote paths')
    # The model is currently fixed by the RAG runtime; retain it in discovery metadata.
    config={key:config[key] for key in ('paths','threads','memory_gb','gpu','compute','paths_location') if key in config}
    config['embedding_model']='BAAI/bge-small-en-v1.5'
    key=hashlib.sha256(json.dumps(config,sort_keys=True).encode()).hexdigest()[:24]
    registry=state/'rags.json'
    saved=json.loads(registry.read_text()) if registry.exists() else {}
    saved[key]=config;write(registry,json.dumps(saved))
    return {'id':key,'config':config}


def claim():
    current=status()
    if not current.get('active'):raise ValueError('Allocation ended')
    owner=current.get('owner') or {}
    if p.get('expected_owner')!=owner.get('id','') or p.get('expected_generation')!=current.get('generation',''):
        raise ValueError('Session changed; refresh and acknowledge its current owner before retrying')
    if not p.get('client_id'):raise ValueError('Client identity required')
    write(state/'owner.json',json.dumps({'id':p['client_id'],'label':p.get('client_label','another machine')}))
    return status()


def reserve():
    if meta.exists(): return status() # Never resubmit an expired allocation silently.
    if int(sl['nodes'])!=1: raise ValueError('Resource sessions support exactly one node')
    if kind not in ('direct','slurm_server','kubernetes'): raise ValueError('Unsupported resource backend')
    if c['llamacpp']['container'] and kind!='kubernetes':
        call([sys.executable,str(root/'scripts/remote/ensure-container.py'),c['llamacpp']['container'],c['llamacpp']['container_source'],c['llamacpp']['container_runtime']])
    worker=['bash',str(root/'bin/resource-worker'),str(state)]
    if kind=='slurm_server':
        args=['sbatch','--parsable','--nodes=1','--ntasks=1','--job-name='+job_label(),
              '--chdir='+str(root),'--output='+str(state/'allocation.log')]
        if sl['partition']: args+=['--partition='+sl['partition']]
        if sl['gpus']: args+=['--gres=gpu:'+str(sl['gpus'])]
        if sl['exclusive']: args+=['--exclusive']
        node=sl['node_class']
        if node in ('mi50','mi100'):
            lines=call(['sinfo','-N','-h','-p',sl['partition'],'-o','%N|%t']).splitlines()
            low,high=(0,279) if node=='mi50' else (280,349)
            idle,busy,fallback=set(),set(),set()
            for line in lines:
                match=re.fullmatch(r'(epn([0-9]+))\|(idle|mix|alloc)',line)
                if not match: continue
                host,number,phase=match.groups(); number=int(number)
                if low<=number<=high:
                    (idle if phase=='idle' else busy).add(host)
                elif node=='mi100' and sl.get('mi50_fallback',False) and 0<=number<=279 and phase=='idle':
                    fallback.add(host)
            if not idle and fallback and c['llamacpp'].get('rocm_arch','auto')!='auto':
                raise ValueError('MI50 fallback requires llamacpp.rocm_arch = auto')
            candidates=sorted(idle or fallback or busy)
            if not candidates: raise ValueError('No usable '+node+' nodes')
            node=candidates[0]
        if node: args+=['--nodelist='+node]
        options=sl['custom_options']
        blocked=('--nodes','--ntasks','--wrap','--output','--error','--chdir','--gres','--gpus','--export','--get-user-env')
        if any(x.startswith(blocked) or x.startswith(('-N','-n','-o','-e','-D')) or '\n' in x for x in options):
            raise ValueError('Additional Slurm options must not override session ownership, GPU count, node count or command')
        script='#!/bin/bash\nexec '+' '.join(shlex.quote(x) for x in worker)+'\n'
        job=call(args+options,data=script).split(';')[0]
    elif kind=='kubernetes':
        # Kubernetes object names must be unique per namespace; Slurm permits duplicates.
        job=job_label()+'-'+token[:6]
        volume={'name':'project'}
        volume.update({'persistentVolumeClaim':{'claimName':k['pvc']}} if k['pvc'] else {'hostPath':{'path':str(root),'type':'Directory'}})
        limits={'cpu':k['cpu'],'memory':k['memory']}
        if sl['gpus']: limits[k['gpu_resource']]=sl['gpus']
        manifest={'apiVersion':'batch/v1','kind':'Job','metadata':{'name':job,'labels':{'llm-remote-resource':token}},'spec':{'backoffLimit':0,'template':{'spec':{'restartPolicy':'Never','automountServiceAccountToken':False,'securityContext':{'runAsUser':os.getuid(),'runAsGroup':os.getgid()},'containers':[{'name':job_label(),'image':k['image'],'command':worker,'workingDir':str(root),'resources':{'limits':limits},'volumeMounts':[{'name':'project','mountPath':str(root)}]}],'volumes':[volume]}}}}
        pod=manifest['spec']['template']['spec']
        if resource_base:
            pod['volumes'].append({'name':'user-state','hostPath':{'path':str(base),'type':'Directory'}})
            pod['containers'][0]['volumeMounts'].append({'name':'user-state','mountPath':str(base)})
            pod['containers'][0]['volumeMounts'][0]['readOnly']=True
        if k.get('node_selector'):pod['nodeSelector']=k['node_selector']
        if k.get('tolerations'):pod['tolerations']=k['tolerations']
        if k.get('priority_class'):pod['priorityClassName']=k['priority_class']
        if k.get('time_limit_seconds',0)>0:manifest['spec']['activeDeadlineSeconds']=k['time_limit_seconds']
        kubectl(['create','-f','-'],json.dumps(manifest))
    else:
        with open(state/'allocation.log','a') as log:
            child=subprocess.Popen(worker,cwd=str(root),stdin=subprocess.DEVNULL,stdout=log,stderr=log,start_new_session=True)
        job=str(child.pid)
    write(meta,json.dumps({'job_id':job,'created':time.time(),'server_port':p['port']}))
    save_descriptor()
    return status()

def start():
    s=status()
    if not s['active']: raise ValueError('Allocation ended; create a new resource session')
    require_owner()
    if not s.get('owner') and p.get('client_id'):
        write(state/'owner.json',json.dumps({'id':p['client_id'],'label':p.get('client_label','another machine')}))
    if s.get('model_state') in ('STARTING','LOADING','LOADED','READY'):
        previous=s.get('session') or {}
        def runtime_settings(settings):
            return {key:value for key,value in settings.items() if key not in ('model_batch_defaults','model_host_batch_defaults')}
        if previous and (previous.get('model')!=c['model'] or runtime_settings(previous.get('llamacpp',{}))!=runtime_settings(c['llamacpp'])):
            raise ValueError('Stop the existing model before changing its configuration')
        return status()
    l=c['llamacpp']
    if l['model_path'] or l['server_command']: raise ValueError('Resource sessions require managed model presets')
    env={'MODEL_NAME':l['model_name'] or c['model']['name'],'LLAMACPP_BACKEND':l['backend'],
         'LLAMACPP_ROCM_ARCH':l['rocm_arch'],'LLAMACPP_CONTAINER':l['container'],'LLAMACPP_CONTAINER_RUNTIME':l['container_runtime'],
         'LLAMACPP_HOST':'127.0.0.1' if kind=='direct' else '0.0.0.0','LLAMACPP_PORT':str(p['port']),
         'LLAMACPP_CTX_SIZE':str(l['context_size']),'LLAMACPP_MTP':l['mtp'],'LLAMACPP_GPU_COUNT':str(sl['gpus'])}
    env.update(LLAMACPP_MODELS_DIR=l.get('models_dir',''), LLAMACPP_INSTALLATION_DIR=l.get('installation_dir',''))
    if kind=='kubernetes': env.update(LLAMACPP_IN_CONTAINER='1',LLAMACPP_CONTAINER='')
    if kind=='direct':
        env['LLAMACPP_VISIBLE_DEVICES']=l['visible_devices']
        if l['visible_devices']: env['CUDA_VISIBLE_DEVICES' if l['backend']=='cuda' else 'ROCR_VISIBLE_DEVICES']=l['visible_devices']
        if l['container'] and l['container_runtime']=='docker': env.update(LLAMACPP_HOST='0.0.0.0',LLAMACPP_PUBLISH_ADDRESS='127.0.0.1')
    args=[str(root/l['server_cli']),'--ctx-size',str(l['context_size'])]+l['server_extra_args']
    script='#!/bin/bash\nset -e\ncd '+shlex.quote(str(root))+'\n'
    script+='unset MODEL_DRAFT_GGUF LLAMACPP_SPEC_TYPE LLAMACPP_EXTRA_ARGS LLAMACPP_VISIBLE_DEVICES\n'
    script+='\n'.join('export '+a+'='+shlex.quote(b) for a,b in env.items())+'\n'
    if kind=='slurm_server': script+='export LLAMACPP_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-${ROCR_VISIBLE_DEVICES:-${HIP_VISIBLE_DEVICES:-}}}"\n'
    script+='if (echo > /dev/tcp/127.0.0.1/'+str(p['port'])+') 2>/dev/null; then echo "Port already in use" >&2; exit 1; fi\n'
    script+='exec '+' '.join(shlex.quote(str(x)) for x in args)+'\n'
    generation=uuid.uuid4().hex
    save_descriptor()
    write(state/(generation+'.sh'),script);write(state/'desired',generation)
    return status()

if action=='list':
    result=[]
    original=c
    for candidate in sorted(state.parent.glob('*')):
        if not re.fullmatch('[a-f0-9]{32}',candidate.name) or candidate.is_symlink() or candidate.stat().st_uid!=os.getuid():continue
        if not (candidate/'allocation.json').exists() or not (candidate/'session.json').exists():continue
        state=candidate;meta=state/'allocation.json'
        lock_dir=state.parent/'.locks';lock_dir.mkdir(mode=0o700,exist_ok=True)
        with open(lock_dir/(candidate.name+'.lock'),'a') as lock:
            fcntl.flock(lock,fcntl.LOCK_EX)
            c=dict(original,**json.loads((state/'session.json').read_text()))
            kind=c['backend_type'];k=c['kubernetes'];sl=c['slurm']
            item=status()
            if item.get('active'):result.append(dict(item,token=candidate.name))
    print(json.dumps({'sessions':result}));sys.exit(0)

lock_dir=state.parent/'.locks'
lock_dir.mkdir(mode=0o700,exist_ok=True)
with open(lock_dir/(token+'.lock'),'a') as lock:
    fcntl.flock(lock,fcntl.LOCK_EX)
    if action in ('rag-register','terminal-start','terminal-send','terminal-stop'):require_attachment()
    elif action not in ('status','reserve','claim','attach','log','agent-info','cleanup-preview'):
        require_owner()
    if meta.exists() and not (state/'session.json').exists() and action in ('status','reserve'):
        save_descriptor()
    if action=='attach':result=attach()
    elif action=='rag-register':result=register_rag()
    elif action=='claim':result=claim()
    elif action=='cleanup' and not any(state.iterdir()):
        # An earlier cleanup may have removed its metadata before NFS released
        # the old in-directory lock. Empty directories need no further proof.
        state.rmdir();result={'cleaned':True,'already_empty':True}
    elif action=='reserve': result=reserve()
    elif action=='status': result=status()
    elif action=='start': result=start()
    elif action=='stop':
        write(state/'desired',uuid.uuid4().hex);result=status()
    elif action=='release':
        if p.get('explicit_release') is not True:
            raise ValueError('Explicit release required; local process loss must not cancel remote allocations')
        s=status()
        if p.get('only_if_inactive') and s.get('active'):
            raise ValueError('Allocation is active; preserving it')
        with (state/'release-audit.jsonl').open('a') as audit:
            audit.write(json.dumps({'time':time.time(),'client':p.get('client_label',''),
                'client_id':p.get('client_id',''),'job_id':s.get('job_id'),'explicit_release':True})+'\n')
        (state/'release').touch()
        if s.get('active'):
            if kind=='slurm_server': call(['scancel',s['job_id']])
            elif kind=='kubernetes': kubectl(['delete','job',s['job_id'],'--wait=false'])
        result={'released':True}
    elif action=='terminal-start':
        ready=json.loads((state/'prompt-worker.ready').read_text())
        if not isinstance(ready,dict) or ready.get('version',0)<4 or not ready.get('tmux'):
            raise ValueError('Install tmux and start an allocation using the updated terminal worker')
        current=status()
        if not current['active'] or current.get('model_state') not in ('LOADING','LOADED'):raise ValueError('Load a model first')
        if current.get('prompt',{}).get('status') in ('QUEUED','RUNNING'):raise ValueError('Wait for the legacy background task to finish')
        spec=p['spec']
        if spec.get('cli') not in ready.get('clis',[]):raise ValueError('Selected CLI unavailable on compute host')
        # The terminal worker receives the backend identity so resource-bound
        # features can refuse to run on a login/control host by mistake.
        target=client_state();target.mkdir(parents=True,exist_ok=True,mode=0o700)
        spec.update(token=token,terminal_id=token+'-'+target.name,port=int(p['port']),allocation_kind=kind)
        write(target/'terminal-status.json',json.dumps({'status':'STARTING'}))
        write(target/'terminal-launch.json',json.dumps(spec))
        result={'starting':True}
    elif action=='terminal-stop':
        target=client_state();target.mkdir(parents=True,exist_ok=True,mode=0o700)
        write(target/'terminal-stop','1');result={'stopping':True}
    elif action=='terminal-send':
        if status().get('terminal',{}).get('status')!='TERMINAL':raise ValueError('Open the agent terminal first')
        if (client_state()/'terminal-prompt.json').exists():raise ValueError('Previous prompt is still being delivered')
        text=p.get('prompt','').strip()
        if not text or len(text)>100000:raise ValueError('Prompt must contain 1–100000 characters')
        write(client_state()/'terminal-prompt.json',json.dumps({'prompt':text}));result={'queued':True}
    elif action=='agent-info':
        ready=state/'prompt-worker.ready'
        result=json.loads(ready.read_text()) if ready.exists() else {}
        if not isinstance(result,dict):result={}
    elif action=='prompt':
        current=status()
        if not current['active'] or current.get('model_state') not in ('LOADING','LOADED') or (state/'release').exists():
            raise ValueError('Session has no running model')
        if not (state/'prompt-worker.ready').exists():
            raise ValueError('Background prompts require the updated remote worker; create a new allocation')
        if current.get('prompt',{}).get('status') in ('QUEUED','RUNNING'):
            raise ValueError('A background prompt is already running')
        text=p.get('prompt','').strip()
        if not text or len(text)>100000:raise ValueError('Prompt must contain 1–100000 characters')
        if p.get('cli') not in ('codex','claude'):raise ValueError('Select a Codex or Claude agent for background prompts')
        ready=json.loads((state/'prompt-worker.ready').read_text())
        if not isinstance(ready,dict) or p['cli'] not in ready.get('clis',[]):raise ValueError('Selected CLI unavailable on compute host; update worker/install CLI and create a new allocation')
        prompt_id=uuid.uuid4().hex
        queue=state/'prompts';queue.mkdir(exist_ok=True)
        request={'id':prompt_id,'prompt':text,'cli':p['cli'],'cwd':p.get('cwd',''),'instructions':p.get('instructions',''),'generation':(state/'desired').read_text().strip(),
                 'port':int(p['port']),'model':c['model']['name'],
                 'max_tokens':int(c['llamacpp']['max_tokens']),
                 'timeout':int(c['llamacpp']['inference_timeout_seconds'])}
        write(queue/(prompt_id+'.json'),json.dumps(request))
        write(state/'prompt-latest',prompt_id)
        result={'id':prompt_id,'status':'QUEUED'}
    elif action in ('cleanup','cleanup-preview'):
        if not (state/'release').is_file() or not meta.is_file():
            raise ValueError('Keep remote state: allocation is not explicitly released')
        if status()['active']:
            raise ValueError('Keep remote state: allocation is still active')
        worker_state=state/'worker.state'
        if worker_state.exists() and 'STOPPED' not in worker_state.read_text().split():
            raise ValueError('Keep remote state: worker shutdown is not confirmed')
        if kind=='direct':
            pid=json.loads(meta.read_text()).get('job_id')
            if pid:
                try: os.kill(int(pid),0)
                except ProcessLookupError: pass
                else: raise ValueError('Keep remote state: worker PID is still alive')
        paths=sorted([str(state)]+[str(path) for path in state.rglob('*')])
        if action=='cleanup-preview':
            result={'paths':paths}
        else:
            if 'expected_paths' in p and paths!=p['expected_paths']:
                raise ValueError('Remote files changed since preview; review cleanup again')
            shutil.rmtree(str(state))
            result={'cleaned':True}
    elif action=='log':
        path=state/'model.log'; offset=int(p.get('offset',0))
        data=b''
        if path.exists():
            with path.open('rb') as f:
                f.seek(min(offset,path.stat().st_size)); data=f.read(65536); offset=f.tell()
        result={'data':data.decode('utf-8','replace'),'offset':offset}
    else: raise ValueError('Unknown action')
print(json.dumps(result))
