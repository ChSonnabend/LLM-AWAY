#!/usr/bin/env python3
"""Persistent interactive agent terminal helpers (Python 3.6+)."""
import fcntl
import json
import os
from pathlib import Path
import runpy
import shlex
import shutil
import signal
import subprocess
import sys
import time


def clipboard_command():
    for command in (['pbcopy'], ['wl-copy'], ['xclip','-selection','clipboard']):
        if shutil.which(command[0]):return command
    return None



def tmux(state=None):
    bundled=Path(__file__).resolve().parents[2]/'local/run/tools/bin/tmux'
    binary=shutil.which('tmux') or (str(bundled) if bundled.is_file() else None)
    if not binary:raise ValueError('tmux is required on the agent host. On macOS: brew install tmux')
    return [binary,'-L','llm-'+name(state) if state is not None else 'llm-away','-f','/dev/null']


def name(state):
    return 'away-'+json.loads((Path(state)/'terminal.json').read_text())['token']


def alive(state):
    if not (Path(state)/'terminal.json').exists():return False
    try:tmux()
    except ValueError:return False
    return subprocess.call(tmux(state)+['has-session','-t',name(state)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)==0


def start(state,spec):
    state=Path(state)
    if alive(state):return
    tmux()
    error=state/'terminal-error.txt'
    if error.exists():error.unlink()
    path=state/'terminal.json';tmp=state/'terminal.tmp';tmp.write_text(json.dumps(spec));os.chmod(str(tmp),0o600);os.replace(str(tmp),str(path))
    command='exec '+' '.join(shlex.quote(x) for x in [sys.executable,__file__,'worker',str(state)])
    subprocess.check_call(tmux(state)+['new-session','-d','-s',name(state),'-x','120','-y','35','-e','PATH='+os.environ.get('PATH',''),command])
    configure(state)


def configure(state):
    target=name(state)
    for option,value in [('remain-on-exit','off'),('history-limit','100000'),('mouse','on'),('mode-keys','vi')]:
        subprocess.check_call(tmux(state)+['set-option','-t',target,option,value])
    subprocess.check_call(tmux(state)+['set-option','-g','set-clipboard','on'])
    subprocess.check_call(tmux(state)+['set-option','-as','terminal-overrides',',*:Ms=\\E]52;c;%p2%s\\007'])
    copy=clipboard_command()
    for table in ('copy-mode','copy-mode-vi'):
        action=['copy-pipe-and-cancel',' '.join(shlex.quote(x) for x in copy)] if copy else ['copy-selection-and-cancel']
        subprocess.check_call(tmux(state)+['bind-key','-T',table,'C-c','send-keys','-X',*action])
        # Finish mouse selection immediately so subsequent typing reaches the agent.
        subprocess.check_call(tmux(state)+['bind-key','-T',table,'MouseDragEnd1Pane','send-keys','-X',*action])
        subprocess.call(tmux(state)+['unbind-key','-T',table,'C-v'],stderr=subprocess.DEVNULL)
    # Let macOS terminal paste and application Ctrl+V handling pass through.
    if sys.platform=='darwin':
        subprocess.call(tmux(state)+['unbind-key','-n','C-v'],stderr=subprocess.DEVNULL)
        return
    paste=next((c for c in (['pbpaste'],['wl-paste','--no-newline'],['xclip','-selection','clipboard','-o']) if shutil.which(c[0])),None)
    if paste:
        base=' '.join(shlex.quote(x) for x in tmux(state))
        script=' '.join(shlex.quote(x) for x in paste)+' | '+base+' load-buffer - && '+base+' paste-buffer -p -d -t '+shlex.quote('#{pane_id}')
        subprocess.check_call(tmux(state)+['bind-key','-n','C-v','run-shell',script])
    else:
        subprocess.check_call(tmux(state)+['bind-key','-n','C-v','paste-buffer','-p'])


def send(state,text):
    if not alive(state):raise ValueError('Agent terminal has exited; reopen it with run or F4')
    buffer='prompt-'+name(state)
    p=subprocess.Popen(tmux(state)+['load-buffer','-b',buffer,'-'],stdin=subprocess.PIPE)
    p.communicate(text.encode())
    if p.returncode:raise ValueError('Could not load prompt into tmux')
    subprocess.check_call(tmux(state)+['paste-buffer','-d','-b',buffer,'-t',name(state)])
    subprocess.check_call(tmux(state)+['send-keys','-t',name(state),'Enter'])


def capture(state):
    if not alive(state):return {'status':'EXITED','text':'Agent terminal exited. Use F4 to reopen.'}
    text=subprocess.check_output(tmux(state)+['capture-pane','-p','-t',name(state),'-S','-2000'],universal_newlines=True)
    # Codex's interactive prompt footer carries no reply content; drop it and
    # everything after so status previews end with the model's actual output.
    lines=text.splitlines()
    marker='› Ask Codex to do anything'
    for index in range(len(lines)-1,-1,-1):
        if lines[index].strip()==marker:lines=lines[:index];break
    while lines and not lines[-1].strip():lines.pop()
    text='\n'.join(lines)+'\n' if lines else ''
    return {'status':'TERMINAL','text':text[-32768:]}


def stop(state):
    if alive(state):subprocess.check_call(tmux(state)+['kill-session','-t',name(state)])
    record=Path(state)/'terminal-status.json'
    if record.exists():record.write_text(json.dumps({'status':'EXITED','text':'Agent terminal stopped.'}))


def worker(state):
    state=Path(state);spec=json.loads((state/'terminal.json').read_text())
    lease=None;proxy=None;child=None;guarded=False;terminated=False
    def terminate(*args):
        nonlocal terminated
        terminated=True
        sys.exit(0)
    signal.signal(signal.SIGTERM,terminate)
    signal.signal(signal.SIGHUP,terminate)
    signal.signal(signal.SIGINT,lambda *args:None)
    try:
        spec['state']=str(state)
        if spec.get('resource_session_id') is not None:
            os.environ['LLM_AWAY_SESSION_ID']=str(spec['resource_session_id'])
            os.environ['LLM_AWAY_SESSION_TOKEN']=spec['token']
        if spec.get('local'):
            lease=(state/'client.lock').open('a')
            fcntl.flock(lease,fcntl.LOCK_EX)
        if spec.get('native') and spec.get('local') and (state/'session.json').exists():
            sys.path.insert(0,str(Path(__file__).resolve().parents[2]/'local/src'))
            from llm_away.session_guard import register
            register(state);guarded=True
        if spec.get('loading'):
            sys.path.insert(0,str(Path(__file__).resolve().parents[2]/'local/src'))
            from llm_away.loading import prepare
            if prepare(state,spec):return
        engine=runpy.run_path(str(Path(__file__).with_name('resource-agent')))
        base_url=spec['base_url']
        if spec.get('native'):
            command=[spec['cli']]+spec.get('extra_args',[])
            if spec.get('native_host'):
                command=['ssh','-tt',spec['native_host'],shlex.join(command)]
            env=os.environ.copy()
            cwd=Path(spec['cwd']) if spec.get('cwd') else state/'agent-workspace'
            if not spec.get('cwd'):cwd.mkdir(exist_ok=True)
            if not cwd.is_dir():raise ValueError('Working directory does not exist: '+str(cwd))
            child=subprocess.Popen(command,cwd=str(cwd),env=env)
            child.wait()
            return
        if spec['cli']=='claude':
            proxy=engine['claude_proxy'](base_url);base_url='http://127.0.0.1:'+str(proxy.server_port)
        command,env=engine['agent_command'](spec,base_url)
        if spec['cli']=='claude':
            for option in ('--print','--verbose'):command.remove(option)
            index=command.index('--output-format');del command[index:index+2]
        else:
            for option in ('exec','--json','--skip-git-repo-check','-'):command.remove(option)
            command.insert(1,'--no-alt-screen')
        command+=spec.get('extra_args',[])
        if spec.get('rag_command'):
            rag=spec['rag_command']
            if spec['cli']=='claude':command+=['--mcp-config',json.dumps({'mcpServers':{'project_search':{'command':rag[0],'args':rag[1:]}}})]
            else:command+=['-c','mcp_servers.project_search.command='+json.dumps(rag[0]),'-c','mcp_servers.project_search.args='+json.dumps(rag[1:])]
        cwd=Path(spec['cwd']) if spec.get('cwd') else state/'agent-workspace'
        if not spec.get('cwd'):cwd.mkdir(exist_ok=True)
        if not cwd.is_dir():raise ValueError('Working directory does not exist: '+str(cwd))
        child=subprocess.Popen(command,cwd=str(cwd),env=env)
        child.wait()
    except Exception as exc:
        print('Agent terminal failed: '+str(exc),flush=True)
        (state/'terminal-error.txt').write_text(str(exc))
        time.sleep(3)
    finally:
        if child and child.poll() is None:
            child.terminate()
            try:child.wait(timeout=5)
            except subprocess.TimeoutExpired:child.kill();child.wait()
        if proxy:proxy.shutdown();proxy.server_close()
        if lease:lease.close()
        if guarded and not terminated:
            from llm_away.session_guard import finished
            finished(state)


if __name__=='__main__':
    if sys.argv[1]=='worker':worker(sys.argv[2])
    elif sys.argv[1]=='stop':stop(sys.argv[2])
