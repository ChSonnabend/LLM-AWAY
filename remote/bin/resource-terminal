#!/usr/bin/env python3
"""Persistent interactive agent terminal helpers (Python 3.6+)."""
import fcntl
import json
import os
from pathlib import Path
import runpy
import shlex
import shutil
import signal
import subprocess
import sys
import time
import socket
import threading


def clipboard_command():
    for command in (['pbcopy'], ['wl-copy'], ['xclip','-selection','clipboard']):
        if shutil.which(command[0]):return command
    return None



def tmux(state=None):
    bundled=Path(__file__).resolve().parents[2]/'local/run/tools/bin/tmux'
    binary=shutil.which('tmux') or (str(bundled) if bundled.is_file() else None)
    if not binary:raise ValueError('tmux is required on the agent host. On macOS: brew install tmux')
    # The user's default tmux socket keeps every agent visible to plain `tmux ls`.
    command=[binary,'-L','default']
    if state is not None and (Path(state)/'terminal.json').exists():
        target=name(state)
        if subprocess.call(command+['has-session','-t','='+target],
                           stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)!=0:
            # Preserve access to agents started before the default-socket fix.
            legacy=[binary,'-L','llm-'+target]
            if subprocess.call(legacy+['has-session','-t','='+target],
                               stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)==0:
                return legacy
    return command


def name(state):
    spec=json.loads((Path(state)/'terminal.json').read_text())
    return 'away-'+spec.get('terminal_id',spec['token'])


def alive(state):
    if not (Path(state)/'terminal.json').exists():return False
    try:tmux()
    except ValueError:return False
    return subprocess.call(tmux(state)+['has-session','-t',name(state)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)==0


def start(state,spec):
    state=Path(state)
    if alive(state):return
    tmux()
    for marker in ('agent-ready','resume-requested'):
        if (state/marker).exists():(state/marker).unlink()
    error=state/'terminal-error.txt'
    if error.exists():error.unlink()
    path=state/'terminal.json';tmp=state/'terminal.tmp';tmp.write_text(json.dumps(spec));os.chmod(str(tmp),0o600);os.replace(str(tmp),str(path))
    command='exec '+' '.join(shlex.quote(x) for x in [sys.executable,__file__,'worker',str(state)])
    identity=[] if spec.get('resource_session_id') is None else [
        arg for key,value in (('LLM_AWAY_SESSION_ID',spec['resource_session_id']),
                              ('LLM_AWAY_SESSION_TOKEN',spec['token'])) for arg in ('-e',key+'='+str(value))]
    subprocess.check_call(tmux(state)+['new-session','-d','-s',name(state),'-x','120','-y','35',
        '-e','PATH='+os.environ.get('PATH',''),*identity,command])
    configure(state)


def configure(state):
    target=name(state)
    for option,value in [('remain-on-exit','off'),('history-limit','100000'),('mouse','on'),('mode-keys','vi'),('cursor-style','block')]:
        subprocess.check_call(tmux(state)+['set-option','-t',target,option,value])
    subprocess.check_call(tmux(state)+['set-option','-g','set-clipboard','on'])
    override=',*:Ms=\\E]52;c;%p2%s\\007'
    current=subprocess.check_output(tmux(state)+['show-options','-sv','terminal-overrides'],universal_newlines=True)
    if override[1:] not in current:
        subprocess.check_call(tmux(state)+['set-option','-as','terminal-overrides',override])
    copy=clipboard_command()
    for table in ('copy-mode','copy-mode-vi'):
        action=['copy-pipe-and-cancel',' '.join(shlex.quote(x) for x in copy)] if copy else ['copy-selection-and-cancel']
        subprocess.check_call(tmux(state)+['bind-key','-T',table,'C-c','send-keys','-X',*action])
        # Finish mouse selection immediately so subsequent typing reaches the agent.
        subprocess.check_call(tmux(state)+['bind-key','-T',table,'MouseDragEnd1Pane','send-keys','-X',*action])
        subprocess.call(tmux(state)+['unbind-key','-T',table,'C-v'],stderr=subprocess.DEVNULL)
    # Let macOS terminal paste and application Ctrl+V handling pass through.
    if sys.platform=='darwin':
        subprocess.call(tmux(state)+['unbind-key','-n','C-v'],stderr=subprocess.DEVNULL)
        return
    paste=next((c for c in (['pbpaste'],['wl-paste','--no-newline'],['xclip','-selection','clipboard','-o']) if shutil.which(c[0])),None)
    if paste:
        base=' '.join(shlex.quote(x) for x in tmux(state))
        script=' '.join(shlex.quote(x) for x in paste)+' | '+base+' load-buffer - && '+base+' paste-buffer -p -d -t '+shlex.quote('#{pane_id}')
        subprocess.check_call(tmux(state)+['bind-key','-n','C-v','run-shell',script])
    else:
        subprocess.check_call(tmux(state)+['bind-key','-n','C-v','paste-buffer','-p'])


def attach(state):
    configure(state)
    def visible_cursor():
        if sys.stdout.isatty():
            sys.stdout.write('\x1b[0 q\x1b[?25h');sys.stdout.flush()
    visible_cursor()
    try:
        return subprocess.call(tmux(state)+['attach-session','-t','='+name(state)])
    finally:
        visible_cursor()


def send(state,text):
    if not alive(state):raise ValueError('Agent terminal has exited; reopen it with run or F2')
    buffer='prompt-'+name(state)
    p=subprocess.Popen(tmux(state)+['load-buffer','-b',buffer,'-'],stdin=subprocess.PIPE)
    p.communicate(text.encode())
    if p.returncode:raise ValueError('Could not load prompt into tmux')
    subprocess.check_call(tmux(state)+['paste-buffer','-d','-b',buffer,'-t',name(state)])
    subprocess.check_call(tmux(state)+['send-keys','-t',name(state),'Enter'])


def capture(state):
    if not alive(state):return {'status':'EXITED','text':'Agent terminal exited. Use F2 to reopen.'}
    text=subprocess.check_output(tmux(state)+['capture-pane','-p','-t',name(state),'-S','-2000'],universal_newlines=True)
    # Codex's interactive prompt footer carries no reply content; drop it and
    # everything after so status previews end with the model's actual output.
    lines=text.splitlines()
    marker='› Ask Codex to do anything'
    for index in range(len(lines)-1,-1,-1):
        if lines[index].strip()==marker:lines=lines[:index];break
    while lines and not lines[-1].strip():lines.pop()
    text='\n'.join(lines)+'\n' if lines else ''
    return {'status':'TERMINAL','text':text[-32768:]}


def stop(state):
    for child in (Path(state)/'clients').glob('*'):stop(child)
    if alive(state):subprocess.check_call(tmux(state)+['kill-session','-t',name(state)])
    bridge=Path(state)/'rag-bridge.json'
    if bridge.exists():
        try:os.killpg(int(json.loads(bridge.read_text())['pid']),signal.SIGTERM)
        except (OSError,ValueError,KeyError):pass
        bridge.unlink()
    record=Path(state)/'terminal-status.json'
    if record.exists():record.write_text(json.dumps({'status':'EXITED','text':'Agent terminal stopped.'}))


def helper_environment(command, spec):
    """Carry allocation identity across Codex's filtered MCP environment."""
    if spec.get('cli')!='codex' or spec.get('native_host') or spec.get('resource_session_id') is None:
        return command
    for helper in spec.get('helper_session_ids',[]):
        prefix='mcp_servers.session_helper_'+str(int(helper))+'.env.'
        for key,value in [('LLM_AWAY_SESSION_ID',str(spec['resource_session_id'])),
                          ('LLM_AWAY_SESSION_TOKEN',spec['token'])]:
            command+=['-c',prefix+key+'='+json.dumps(value)]
    return command


def resume_picker(command, spec):
    """Select a saved conversation explicitly; never silently resume the latest."""
    if spec.get('resume'):
        command.insert(1, '--resume' if spec['cli']=='claude' else 'resume')
    return command


def prepare_rag(spec):
    config=dict(spec.get('rag_config') or {})
    if not config:return None
    if spec.get('allocation_kind')=='slurm_server' and not os.environ.get('SLURM_JOB_ID'):
        raise ValueError('Refusing to start remote RAG outside its Slurm allocation')
    source=Path(__file__).resolve().parents[2]/'local/src'
    if not (source/'llm_away/rag.py').is_file():
        raise ValueError('Remote RAG requires a full LLM-AWAY checkout containing local/src')
    sys.path.insert(0,str(source))
    from llm_away.rag import prepare
    return prepare(config.get('paths') or [],config.get('threads',2),
                   config.get('memory_gb',0),config.get('gpu',False),
                   config.get('status_log') or spec.get('rag_log_path'))


def rag_stdio(raw):
    """Run the RAG MCP server here while carrying stdio to a local agent."""
    spec=json.loads(raw)
    command=prepare_rag(spec)
    if not command:raise ValueError('Missing remote RAG configuration')
    os.execvpe(command[0],command,os.environ.copy())


def socket_copy(source,target):
    try:
        while True:
            data=source.recv(65536) if hasattr(source,'recv') else os.read(source.fileno(),65536)
            if not data:break
            if hasattr(target,'sendall'):target.sendall(data)
            else:target.write(data);target.flush()
    except (BrokenPipeError,OSError):pass
    finally:
        if hasattr(target,'shutdown'):
            try:target.shutdown(socket.SHUT_WR)
            except OSError:pass


def rag_socket_server(path):
    path=Path(path);path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    if path.exists():path.unlink()
    server=socket.socket(socket.AF_UNIX);server.bind(str(path));os.chmod(str(path),0o600);server.listen(1)
    try:
        connection,_=server.accept()
        threads=[threading.Thread(target=socket_copy,args=(connection,sys.stdout.buffer),daemon=True),
                 threading.Thread(target=socket_copy,args=(sys.stdin.buffer,connection),daemon=True)]
        for thread in threads:thread.start()
        for thread in threads:thread.join()
    finally:
        server.close()
        try:path.unlink()
        except FileNotFoundError:pass


def rag_socket_client(path):
    connection=socket.socket(socket.AF_UNIX);deadline=time.time()+30
    while True:
        try:connection.connect(path);break
        except (FileNotFoundError,ConnectionRefusedError):
            if time.time()>=deadline:raise ValueError('Local RAG bridge did not become ready')
            time.sleep(.2)
    threads=[threading.Thread(target=socket_copy,args=(connection,sys.stdout.buffer),daemon=True),
             threading.Thread(target=socket_copy,args=(sys.stdin.buffer,connection),daemon=True)]
    for thread in threads:thread.start()
    for thread in threads:thread.join()


def worker(state):
    state=Path(state);spec=json.loads((state/'terminal.json').read_text())
    lease=None;proxy=None;child=None;guarded=False;terminated=False
    def terminate(*args):
        nonlocal terminated
        terminated=True
        sys.exit(0)
    signal.signal(signal.SIGTERM,terminate)
    signal.signal(signal.SIGHUP,terminate)
    signal.signal(signal.SIGINT,lambda *args:None)
    try:
        spec['state']=str(state)
        if spec.get('resource_session_id') is not None:
            os.environ['LLM_AWAY_SESSION_ID']=str(spec['resource_session_id'])
            os.environ['LLM_AWAY_SESSION_TOKEN']=spec['token']
        if spec.get('local'):
            lease=(state/'client.lock').open('a')
            fcntl.flock(lease,fcntl.LOCK_EX)
        if spec.get('native') and spec.get('local') and (state/'session.json').exists():
            sys.path.insert(0,str(Path(__file__).resolve().parents[2]/'local/src'))
            from llm_away.session_guard import register
            register(state);guarded=True
        if spec.get('loading'):
            sys.path.insert(0,str(Path(__file__).resolve().parents[2]/'local/src'))
            from llm_away.loading import prepare
            if prepare(state,spec):return
        if spec.get('rag_config'):
            spec['rag_log_path']=str(state/'rag.log')
            spec['rag_command']=prepare_rag(spec)
        (state/'agent-ready').touch()
        if (state/'resume-requested').exists():spec['resume']=True
        engine=runpy.run_path(str(Path(__file__).with_name('resource-agent')))
        base_url=spec['base_url']
        if spec.get('native'):
            command=helper_environment([spec['cli']]+spec.get('extra_args',[]),spec)
            if spec.get('native_host'):
                command=['ssh','-tt',spec['native_host'],shlex.join(command)]
            env=os.environ.copy()
            cwd=Path(spec['cwd']) if spec.get('cwd') else state/'agent-workspace'
            if not spec.get('cwd'):cwd.mkdir(exist_ok=True)
            if not cwd.is_dir():raise ValueError('Working directory does not exist: '+str(cwd))
            child=subprocess.Popen(command,cwd=str(cwd),env=env)
            child.wait()
            return
        if spec['cli']=='claude':
            proxy=engine['claude_proxy'](base_url);base_url='http://127.0.0.1:'+str(proxy.server_port)
        command,env=engine['agent_command'](spec,base_url)
        if spec['cli']=='claude':
            for option in ('--print','--verbose'):command.remove(option)
            index=command.index('--output-format');del command[index:index+2]
        else:
            for option in ('exec','--json','--skip-git-repo-check','-'):command.remove(option)
            command.insert(1,'--no-alt-screen')
        command=helper_environment(resume_picker(command,spec),spec)
        command+=spec.get('extra_args',[])
        if spec.get('rag_command'):
            rag=spec['rag_command']
            if spec['cli']=='claude':command+=['--mcp-config',json.dumps({'mcpServers':{'project_search':{'command':rag[0],'args':rag[1:]}}})]
            else:command+=['-c','mcp_servers.project_search.command='+json.dumps(rag[0]),'-c','mcp_servers.project_search.args='+json.dumps(rag[1:])]
        cwd=Path(spec['cwd']) if spec.get('cwd') else state/'agent-workspace'
        if not spec.get('cwd'):cwd.mkdir(exist_ok=True)
        if not cwd.is_dir():raise ValueError('Working directory does not exist: '+str(cwd))
        child=subprocess.Popen(command,cwd=str(cwd),env=env)
        child.wait()
    except Exception as exc:
        print('Agent terminal failed: '+str(exc),flush=True)
        (state/'terminal-error.txt').write_text(str(exc))
        time.sleep(3)
    finally:
        if child and child.poll() is None:
            child.terminate()
            try:child.wait(timeout=5)
            except subprocess.TimeoutExpired:child.kill();child.wait()
        if proxy:proxy.shutdown();proxy.server_close()
        if lease:lease.close()
        if guarded and not terminated:
            from llm_away.session_guard import finished
            finished(state)


if __name__=='__main__':
    if sys.argv[1]=='worker':worker(sys.argv[2])
    elif sys.argv[1]=='stop':stop(sys.argv[2])
    elif sys.argv[1]=='attach':sys.exit(attach(sys.argv[2]))
    elif sys.argv[1]=='rag-stdio':rag_stdio(sys.argv[2])
    elif sys.argv[1]=='rag-socket-server':rag_socket_server(sys.argv[2])
    elif sys.argv[1]=='rag-socket-client':rag_socket_client(sys.argv[2])
