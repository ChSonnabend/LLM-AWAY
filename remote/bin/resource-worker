#!/usr/bin/env bash
# One persistent allocation; commands are atomically published by resource-control.
set -uo pipefail
state=$1
child=''
seen=''
prompt_pid=''
telemetry_pid=''
ready=''
health_tick=0
stop_model() {
    python3 "$(dirname "${BASH_SOURCE[0]}")/resource-terminal" stop "$state" 2>/dev/null || true
    if [[ -n "$prompt_pid" ]]; then
        kill "$prompt_pid" 2>/dev/null || true
        wait "$prompt_pid" 2>/dev/null || true
        prompt_pid=''
    fi
    if [[ -n "$child" ]]; then
        kill "$child" 2>/dev/null || true
        for ((i=0;i<50;i++)); do
            kill -0 "$child" 2>/dev/null || break
            sleep 0.1
        done
        kill -KILL "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
        child=''
    fi
}
report() {
    printf '%s %s %s\n' "$seen" "$1" "$(hostname)" > "$state/worker.tmp"
    mv "$state/worker.tmp" "$state/worker.state"
}
cleanup() { stop_model; [[ -z "$telemetry_pid" ]] || kill "$telemetry_pid" 2>/dev/null || true; report STOPPED; }
trap cleanup EXIT
trap 'exit 0' TERM INT HUP
report IDLE
touch "$state/heartbeat"
python3 "$(dirname "${BASH_SOURCE[0]}")/resource-telemetry" "$state" >> "$state/allocation.log" 2>&1 &
telemetry_pid=$!
python3 "$(dirname "${BASH_SOURCE[0]}")/resource-prompts" "$state" >> "$state/model.log" 2>&1 &
prompt_pid=$!
while [[ ! -f "$state/release" ]]; do
    touch "$state/heartbeat"
    if [[ -n "$telemetry_pid" ]] && ! kill -0 "$telemetry_pid" 2>/dev/null; then
        wait "$telemetry_pid" 2>/dev/null || true
        telemetry_pid=''
    fi
    if [[ -z "$telemetry_pid" ]]; then
        python3 "$(dirname "${BASH_SOURCE[0]}")/resource-telemetry" "$state" >> "$state/allocation.log" 2>&1 &
        telemetry_pid=$!
    fi
    desired=$(cat "$state/desired" 2>/dev/null || true)
    if [[ -n "$desired" && "$desired" != "$seen" ]]; then
        stop_model
        seen=$desired
        ready=''
        health_tick=0
        if [[ -f "$state/$seen.sh" ]]; then
            bash "$state/$seen.sh" >> "$state/model.log" 2>&1 &
            child=$!
            python3 "$(dirname "${BASH_SOURCE[0]}")/resource-prompts" "$state" >> "$state/model.log" 2>&1 &
            prompt_pid=$!
            report LOADING
        else
            report IDLE
        fi
    fi
    # Readiness belongs to the allocation, even when no local provider is attached.
    if [[ -n "$child" && -z "$ready" ]] && (( SECONDS >= health_tick )); then
        health_tick=$((SECONDS + 5))
        if python3 - "$state/allocation.json" <<'HEALTH'
import json, sys
from urllib.request import urlopen
try:
    with open(sys.argv[1]) as stream: port=json.load(stream)['server_port']
    with urlopen('http://127.0.0.1:%s/health' % port,timeout=1) as response:
        healthy=response.status==200 and json.load(response).get('status')=='ok'
    sys.exit(0 if healthy else 1)
except Exception:
    sys.exit(1)
HEALTH
        then
            ready=1
            report LOADED
        fi
    fi
    if [[ -n "$child" ]] && ! kill -0 "$child" 2>/dev/null; then
        wait "$child"; code=$?
        echo "Model process exited ($code)" >> "$state/model.log"
        child=''
        report EXITED
    fi
    sleep 1
done
